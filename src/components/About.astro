---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
	lang: Lang;
	eyebrow: string;
	title: string;
	lead: string;
	mission: string;
	paragraphs: string[];
	image?: ImageMetadata;
	imageAlt?: string;
	stats?: {
		participants?: string;
		countries?: number;
		groups?: number;
	};
}

const { lang, eyebrow, title, lead, mission, paragraphs, image, imageAlt, stats } = Astro.props;
const hasStats = Boolean(stats?.participants || stats?.countries || stats?.groups);
---

<section
	class="py-space-xl lg:py-28 bg-surface-container-low border-y border-outline-variant/40"
	id="about"
	data-component="About"
>
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
			<div class="lg:col-span-7 space-y-6">
				<div
					class="inline-block px-2.5 py-1 rounded bronze-border bg-surface text-secondary text-eyebrow tracking-widest uppercase"
				>
					{eyebrow}
				</div>
				<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
					{title}
				</h2>
				<p class="text-body-lg text-on-surface leading-relaxed">{lead}</p>
				<p class="text-body-md text-on-surface font-semibold border-l-4 border-l-primary pl-4">{mission}</p>

				<details class="group rounded-lg bronze-border bg-surface p-4 ambient-card">
					<summary class="cursor-pointer text-label-md text-primary font-semibold list-none flex items-center justify-between">
						<span class="group-open:hidden">{t(lang, 'button.readMore')}</span>
						<span class="hidden group-open:inline">{t(lang, 'button.readLess')}</span>
					</summary>
					<div class="mt-4 space-y-4 text-body-md text-on-surface-variant">
						{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>
				</details>

				{
					hasStats && (
						<div
							class:list={[
								'grid gap-4 pt-6 border-t border-outline-variant/30',
								stats?.groups != null ? 'grid-cols-3' : 'grid-cols-2',
							]}
						>
							{stats?.participants && (
								<div class="p-4 rounded bg-surface bronze-border text-center">
									<div class="text-headline-md text-primary font-bold">{stats.participants}</div>
									<div class="text-eyebrow uppercase text-on-surface-variant mt-1">
										{t(lang, 'about.stats.participants')}
									</div>
								</div>
							)}
							{stats?.countries != null && (
								<div class="p-4 rounded bg-surface bronze-border text-center">
									<div class="text-headline-md text-secondary font-bold">{stats.countries}</div>
									<div class="text-eyebrow uppercase text-on-surface-variant mt-1">
										{t(lang, 'about.stats.countries')}
									</div>
								</div>
							)}
							{stats?.groups != null && (
								<div class="p-4 rounded bg-surface bronze-border text-center">
									<div class="text-headline-md text-primary font-bold">{stats.groups}</div>
									<div class="text-eyebrow uppercase text-on-surface-variant mt-1">
										{t(lang, 'about.stats.groups')}
									</div>
								</div>
							)}
						</div>
					)
				}
			</div>

			{
				image && (
					<div class="lg:col-span-5">
						<div class="relative rounded-xl overflow-hidden bronze-border ambient-card">
							<Image
								src={image}
								alt={imageAlt ?? ''}
								width={800}
								height={1000}
								class="w-full h-[480px] object-cover object-center"
								loading="lazy"
							/>
						</div>
					</div>
				)
			}
		</div>
	</div>
</section>
