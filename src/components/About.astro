---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import PlaceholderMark from './PlaceholderMark.astro';

interface Props {
	lang: Lang;
	eyebrow: string;
	title: string;
	quote?: string;
	paragraphs: string[];
	image: ImageMetadata;
	imageAlt: string;
	imageCredit?: string;
	stats: {
		participants: number;
		countries: number;
		days?: number;
	};
	showDraftMarkers?: boolean;
}

const {
	lang,
	eyebrow,
	title,
	quote,
	paragraphs,
	image,
	imageAlt,
	imageCredit,
	stats,
	showDraftMarkers = false,
} = Astro.props;
---

<section
	class="py-space-xl lg:py-28 bg-surface-container-low border-y border-outline-variant/40"
	id="about"
	data-component="About"
>
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			<div class="lg:col-span-7 space-y-6">
				<div
					class="inline-block px-2.5 py-1 rounded bronze-border bg-surface text-secondary text-eyebrow tracking-widest uppercase"
				>
					{eyebrow}
				</div>
				<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
					{title}
					{showDraftMarkers && <PlaceholderMark lang={lang} />}
				</h2>

				{
					quote && (
						<div class="p-6 rounded-lg bg-surface bronze-border border-l-4 border-l-primary ambient-card">
							<blockquote class="text-headline-sm italic text-on-surface">
								{quote}
								{showDraftMarkers && <PlaceholderMark lang={lang} />}
							</blockquote>
						</div>
					)
				}

				{
					paragraphs.map((paragraph, index) => (
						<p
							class:list={[
								index === 0 ? 'text-body-lg text-on-surface leading-relaxed' : 'text-body-md text-on-surface-variant',
							]}
						>
							{paragraph}
						</p>
					))
				}

				{
					/* Stats figures are placeholders until organiser confirms — only preview with drafts. */
					showDraftMarkers && (
						<div
							class:list={[
								'grid gap-4 pt-6 border-t border-outline-variant/30',
								stats.days != null ? 'grid-cols-3' : 'grid-cols-2',
							]}
						>
							<div class="p-4 rounded bg-surface bronze-border text-center">
								<div class="text-headline-md text-primary font-bold">
									~{stats.participants}
									<PlaceholderMark lang={lang} />
								</div>
								<div class="text-eyebrow uppercase text-on-surface-variant mt-1">
									{t(lang, 'about.stats.participants')}
								</div>
							</div>
							<div class="p-4 rounded bg-surface bronze-border text-center">
								<div class="text-headline-md text-secondary font-bold">
									{stats.countries}
									<PlaceholderMark lang={lang} />
								</div>
								<div class="text-eyebrow uppercase text-on-surface-variant mt-1">
									{t(lang, 'about.stats.countries')}
								</div>
							</div>
							{stats.days != null && (
								<div class="p-4 rounded bg-surface bronze-border text-center">
									<div class="text-headline-md text-primary font-bold">
										{stats.days}
										<PlaceholderMark lang={lang} />
									</div>
									<div class="text-eyebrow uppercase text-on-surface-variant mt-1">
										{t(lang, 'about.stats.days')}
									</div>
								</div>
							)}
						</div>
					)
				}
			</div>

			<div class="lg:col-span-5">
				<div class="relative rounded-xl overflow-hidden bronze-border ambient-card">
					<Image
						src={image}
						alt={imageAlt}
						width={800}
						height={1000}
						class="w-full h-[540px] object-cover object-center"
						loading="lazy"
					/>
					{
						imageCredit && (
							<div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-dark-bg via-dark-bg/80 to-transparent p-6 text-white">
								<p class="text-eyebrow uppercase tracking-widest text-badge-free font-bold">
									{imageCredit}
									{showDraftMarkers && <PlaceholderMark lang={lang} />}
								</p>
							</div>
						)
					}
				</div>
			</div>
		</div>
	</div>
</section>
