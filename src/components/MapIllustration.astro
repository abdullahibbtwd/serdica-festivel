---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import 'leaflet/dist/leaflet.css';

interface Pin {
	name: string;
	lat: number;
	lng: number;
	mapUrl: string;
}

interface Props {
	lang: Lang;
	pins: Pin[];
}

const { lang, pins } = Astro.props;
const mapId = 'festival-venues-map';
---

<figure class="bg-surface-container-high rounded-xl bronze-border p-6 lg:p-8 flex flex-col ambient-card h-full">
	<div class="flex items-center justify-between mb-4">
		<span class="text-eyebrow uppercase text-secondary font-bold tracking-widest">{t(lang, 'map.label')}</span>
		<Icon name="material-symbols:explore" class="text-secondary" aria-hidden="true" />
	</div>
	<p class="text-body-sm text-on-surface-variant mb-4">{t(lang, 'map.caption')}</p>

	<div
		id={mapId}
		class="festival-map relative w-full aspect-square min-h-[280px] rounded bronze-border overflow-hidden z-0 bg-[#FAF2EE]"
		role="region"
		aria-label={t(lang, 'map.label')}
		data-pins={JSON.stringify(pins)}
	>
	</div>

	<p class="mt-3 text-[11px] text-on-surface-variant">
		<a
			class="text-secondary hover:underline font-semibold"
			href="https://www.openstreetmap.org/copyright"
			rel="noopener noreferrer"
			target="_blank"
		>
			© OpenStreetMap
		</a>
	</p>
</figure>

<style is:global>
	.festival-map-pin {
		background: transparent;
		border: none;
	}

	.festival-map-pin__dot {
		display: block;
		width: 22px;
		height: 22px;
		border-radius: 50% 50% 50% 0;
		background: #93000b;
		border: 2px solid #fff8f5;
		box-shadow: 0 2px 8px rgb(28 25 23 / 0.35);
		transform: rotate(-45deg);
	}

	.festival-map-pin--alt .festival-map-pin__dot {
		background: #0f766e;
	}

	.festival-map .leaflet-popup-content-wrapper {
		border-radius: 0.25rem;
		border: 1px solid rgb(146 64 14 / 0.22);
		box-shadow: 0 4px 16px rgb(28 25 23 / 0.06);
	}

	.festival-map .leaflet-popup-content {
		margin: 0.65rem 0.85rem;
		font-size: 0.8125rem;
		line-height: 1.35;
	}
</style>

<script>
	import L from 'leaflet';

	type Pin = { name: string; lat: number; lng: number; mapUrl: string };

	function pinIcon(alt = false) {
		return L.divIcon({
			className: alt ? 'festival-map-pin festival-map-pin--alt' : 'festival-map-pin',
			html: '<span class="festival-map-pin__dot" aria-hidden="true"></span>',
			iconSize: [22, 22],
			iconAnchor: [11, 22],
			popupAnchor: [0, -18],
		});
	}

	function escapeHtml(value: string) {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;');
	}

	function initMap(el: HTMLElement) {
		const raw = el.dataset.pins;
		if (!raw) return;
		const pins = JSON.parse(raw) as Pin[];
		if (!pins.length) return;

		const map = L.map(el, {
			scrollWheelZoom: false,
			attributionControl: false,
		});

		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
		}).addTo(map);

		const bounds = L.latLngBounds([]);
		pins.forEach((pin, index) => {
			const marker = L.marker([pin.lat, pin.lng], { icon: pinIcon(index > 0) }).addTo(map);
			marker.bindPopup(
				`<strong>${escapeHtml(pin.name)}</strong><br/><a href="${escapeHtml(pin.mapUrl)}" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>`,
			);
			bounds.extend([pin.lat, pin.lng]);
		});

		if (pins.length === 1) {
			map.setView([pins[0].lat, pins[0].lng], 17);
		} else {
			map.fitBounds(bounds, { padding: [40, 40], maxZoom: 17 });
		}

		requestAnimationFrame(() => {
			map.invalidateSize();
		});
	}

	function boot() {
		const el = document.getElementById('festival-venues-map');
		if (el && !el.dataset.mapReady) {
			el.dataset.mapReady = '1';
			initMap(el);
		}
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
