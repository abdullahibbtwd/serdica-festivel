---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
	lang: Lang;
	email: string;
	facebook?: string;
}

const { lang, email, facebook } = Astro.props;
---

<section
	class="py-space-xl lg:py-24 bg-surface-container-low border-t border-outline-variant/40"
	id="contact"
	data-component="Contact"
>
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="max-w-3xl mx-auto text-center space-y-4 mb-10">
			<div
				class="inline-block px-2.5 py-1 rounded bronze-border bg-surface text-secondary text-eyebrow tracking-widest uppercase"
			>
				{t(lang, 'contact.eyebrow')}
			</div>
			<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
				{t(lang, 'contact.title')}
			</h2>
			<p class="text-body-md text-on-surface-variant">{t(lang, 'contact.lead')}</p>
		</div>

		<div class="max-w-4xl mx-auto bg-surface rounded-xl bronze-border p-8 lg:p-12 ambient-card">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
				<a
					class="space-y-3 p-6 rounded-lg bg-surface-container-low bronze-border hover:border-secondary transition-colors block h-full"
					href={`mailto:${email}`}
				>
					<div class="flex items-center gap-2 text-primary">
						<Icon name="material-symbols:mail" aria-hidden="true" />
						<span class="text-eyebrow uppercase font-bold tracking-wider">{t(lang, 'contact.emailLabel')}</span>
					</div>
					<p class="text-body-sm text-on-surface-variant">{t(lang, 'contact.emailHint')}</p>
					<span class="inline-block text-headline-sm text-primary hover:underline font-bold break-all pt-1">
						{email}
					</span>
				</a>

				{
					facebook ? (
						<a
							class="space-y-3 p-6 rounded-lg bg-surface-container-low bronze-border hover:border-secondary transition-colors block h-full"
							href={facebook}
							rel="noopener noreferrer"
							target="_blank"
						>
							<div class="flex items-center gap-2 text-secondary">
								<Icon name="material-symbols:public" aria-hidden="true" />
								<span class="text-eyebrow uppercase font-bold tracking-wider">
									{t(lang, 'contact.facebookLabel')}
								</span>
							</div>
							<p class="text-body-sm text-on-surface-variant">{t(lang, 'contact.facebookHint')}</p>
							<span class="inline-flex items-center gap-2 text-headline-sm text-secondary hover:underline font-bold pt-1">
								<span>{t(lang, 'contact.facebookCta')}</span>
								<Icon name="material-symbols:open-in-new" class="text-sm shrink-0" aria-hidden="true" />
							</span>
						</a>
					) : (
						<div class="space-y-3 p-6 rounded-lg bg-surface-container-low bronze-border h-full">
							<div class="flex items-center gap-2 text-secondary">
								<Icon name="material-symbols:public" aria-hidden="true" />
								<span class="text-eyebrow uppercase font-bold tracking-wider">
									{t(lang, 'contact.facebookLabel')}
								</span>
							</div>
							<p class="text-body-sm text-on-surface-variant">{t(lang, 'contact.facebookHint')}</p>
						</div>
					)
				}
			</div>

			<div class="mt-8 pt-6 border-t border-outline-variant/30 text-center">
				<p class="text-body-sm text-on-surface-variant">{t(lang, 'contact.note')}</p>
			</div>
		</div>
	</div>
</section>
