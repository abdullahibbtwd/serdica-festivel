---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import PlaceholderMark from './PlaceholderMark.astro';

type Role = 'organiser' | 'funder' | 'institutional' | 'sponsor';

interface PartnerItem {
	name: string;
	role: Role;
	editions: number[];
	url?: string;
	isDraft: boolean;
}

interface Props {
	lang: Lang;
	items: PartnerItem[];
}

const { lang, items } = Astro.props;

const roleOrder: Role[] = ['organiser', 'funder', 'institutional', 'sponsor'];
const roleKey: Record<Role, 'partners.organiser' | 'partners.funder' | 'partners.institutional' | 'partners.sponsors'> = {
	organiser: 'partners.organiser',
	funder: 'partners.funder',
	institutional: 'partners.institutional',
	sponsor: 'partners.sponsors',
};

const grouped = roleOrder
	.map((role) => ({
		role,
		items: items.filter((item) => item.role === role),
	}))
	.filter((group) => group.items.length > 0);
---

<section class="py-space-xl lg:py-28 bg-background" id="partners" data-component="Partners">
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="max-w-2xl mb-12">
			<div
				class="inline-block px-2.5 py-1 rounded mb-3 bronze-border bg-surface-container-high text-secondary text-eyebrow tracking-widest uppercase"
			>
				{t(lang, 'partners.eyebrow')}
			</div>
			<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
				{t(lang, 'partners.title')}
			</h2>
			<p class="text-body-md text-on-surface-variant mt-2">{t(lang, 'partners.lead')}</p>
		</div>

		<div class="space-y-10">
			{
				grouped.map((group) => (
					<div>
						<span class="text-eyebrow uppercase text-secondary font-bold tracking-widest block mb-4">
							{t(lang, roleKey[group.role])}
						</span>
						<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg list-none p-0 m-0">
							{group.items.map((partner) => {
								const inner = (
									<>
										<span class="font-semibold text-on-surface text-body-md">
											{partner.name}
											{partner.isDraft && <PlaceholderMark lang={lang} />}
										</span>
										<span class="text-xs text-secondary font-bold uppercase tracking-wider mt-2 block">
											{t(lang, 'partners.yearLabel')}: {partner.editions.sort().join(', ')}
										</span>
									</>
								);
								return (
									<li>
										{partner.url ? (
											<a
												href={partner.url}
												rel="noopener noreferrer"
												class="bg-surface-container-low rounded-lg bronze-border p-5 block ambient-card hover:border-secondary transition-colors h-full"
											>
												{inner}
											</a>
										) : (
											<div class="bg-surface-container-low rounded-lg bronze-border p-5 ambient-card h-full">
												{inner}
											</div>
										)}
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
