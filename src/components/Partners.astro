---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import PlaceholderMark from './PlaceholderMark.astro';

interface PartnerItem {
	name: string;
	subtitle?: string;
	url: string;
	icon?: string;
	group: 'organiser' | 'institutional' | 'sponsor';
	isDraft: boolean;
}

interface Props {
	lang: Lang;
	items: PartnerItem[];
}

const { lang, items } = Astro.props;
const organisers = items.filter((item) => item.group === 'organiser');
const institutional = items.filter((item) => item.group === 'institutional');
const sponsors = items.filter((item) => item.group === 'sponsor');
---

<section class="py-space-xl lg:py-28 bg-background" id="partners" data-component="Partners">
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="max-w-2xl mb-12">
			<div
				class="inline-block px-2.5 py-1 rounded mb-3 bronze-border bg-surface-container-high text-secondary text-eyebrow tracking-widest uppercase"
			>
				{t(lang, 'partners.eyebrow')}
			</div>
			<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
				{t(lang, 'partners.title')}
			</h2>
			<p class="text-body-md text-on-surface-variant mt-2">{t(lang, 'partners.lead')}</p>
		</div>

		<div class="space-y-10">
			{
				organisers.length > 0 && (
					<div>
						<span class="text-eyebrow uppercase text-primary font-bold tracking-widest block mb-4">
							{t(lang, 'partners.organiser')}
						</span>
						{organisers.map((partner) => (
							<a
								href={partner.url}
								rel="noopener noreferrer"
								class="bg-surface-container-low rounded-xl bronze-border p-6 lg:p-8 flex flex-col md:flex-row items-center gap-6 ambient-card hover:border-secondary transition-colors"
							>
								{partner.icon && (
									<div class="w-20 h-20 rounded-full bg-surface-container-high flex items-center justify-center bronze-border shrink-0">
										<Icon
											name={`material-symbols:${partner.icon}`}
											class="text-4xl text-primary"
											aria-hidden="true"
										/>
									</div>
								)}
								<div class="space-y-1 text-center md:text-left">
									<h3 class="text-headline-sm text-on-surface font-semibold">
										{partner.name}
										{partner.isDraft && <PlaceholderMark lang={lang} />}
									</h3>
									{partner.subtitle && (
										<p class="text-body-md text-on-surface-variant">{partner.subtitle}</p>
									)}
								</div>
							</a>
						))}
					</div>
				)
			}

			{
				institutional.length > 0 && (
					<div>
						<span class="text-eyebrow uppercase text-secondary font-bold tracking-widest block mb-4">
							{t(lang, 'partners.institutional')}
						</span>
						<ul class="grid grid-cols-1 md:grid-cols-3 gap-space-lg list-none p-0 m-0">
							{institutional.map((partner) => (
								<li>
									<a
										href={partner.url}
										rel="noopener noreferrer"
										class="bg-surface-container-low rounded-lg bronze-border p-5 flex flex-col justify-between ambient-card hover:border-secondary transition-colors h-full min-h-[110px]"
									>
										<div class="flex items-center gap-3 mb-2">
											{partner.icon && (
												<Icon
													name={`material-symbols:${partner.icon}`}
													class="text-primary shrink-0"
													aria-hidden="true"
												/>
											)}
											<h4 class="text-headline-sm text-on-surface text-lg">
												{partner.name}
												{partner.isDraft && <PlaceholderMark lang={lang} />}
											</h4>
										</div>
										{partner.subtitle && (
											<p class="text-body-sm text-on-surface-variant">{partner.subtitle}</p>
										)}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				sponsors.length > 0 && (
					<div>
						<span class="text-eyebrow uppercase text-secondary font-bold tracking-widest block mb-4">
							{t(lang, 'partners.sponsors')}
						</span>
						<ul class="grid grid-cols-1 md:grid-cols-3 gap-space-lg list-none p-0 m-0">
							{sponsors.map((partner) => (
								<li>
									<a
										href={partner.url}
										rel="noopener noreferrer"
										class="bg-surface-container-low rounded-lg bronze-border p-5 flex items-center justify-between ambient-card hover:border-secondary transition-colors h-full"
									>
										<div class="flex items-center gap-3 min-w-0">
											{partner.icon && (
												<Icon
													name={`material-symbols:${partner.icon}`}
													class="text-secondary shrink-0"
													aria-hidden="true"
												/>
											)}
											<span class="font-semibold text-on-surface text-body-md truncate">
												{partner.name}
												{partner.isDraft && <PlaceholderMark lang={lang} />}
											</span>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>
	</div>
</section>
