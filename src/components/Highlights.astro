---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import TagBadge from './TagBadge.astro';
import PlaceholderMark from './PlaceholderMark.astro';

type Tag = 'kids' | 'join-in' | 'battle' | 'craft' | 'food' | 'ceremony' | 'spectacle';

interface HighlightItem {
	time: string;
	title: string;
	description: string;
	locationName: string;
	tags: Tag[];
	isDraft: boolean;
}

interface Props {
	lang: Lang;
	items: HighlightItem[];
}

const { lang, items } = Astro.props;
---

<section
	class="py-space-xl lg:py-28 bg-surface-container-low border-y border-outline-variant/40"
	id="programme-highlights"
	data-component="Highlights"
>
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
			<div class="max-w-2xl">
				<div
					class="inline-block px-2.5 py-1 rounded mb-3 bronze-border bg-surface text-secondary text-eyebrow tracking-widest uppercase"
				>
					{t(lang, 'highlights.eyebrow')}
				</div>
				<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
					{t(lang, 'highlights.title')}
				</h2>
				<p class="text-body-md text-on-surface-variant mt-2">{t(lang, 'highlights.lead')}</p>
			</div>
		</div>

		{
			items.length === 0 ? (
				<p class="text-body-md text-on-surface-variant">{t(lang, 'highlights.empty')}</p>
			) : (
				<div class="space-y-3">
					{items.map((item) => (
						<article class="bg-surface rounded-lg bronze-border p-5 lg:p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:border-secondary transition-all ambient-card">
							<div class="flex items-start md:items-center gap-6 min-w-0">
								<div class="w-20 text-headline-sm text-primary font-bold tracking-tight shrink-0">
									{item.time}
								</div>
								<div class="space-y-1 min-w-0">
									<div class="flex flex-wrap items-center gap-2">
										<h3 class="text-headline-sm text-on-surface font-semibold">
											{item.title}
											{item.isDraft && <PlaceholderMark lang={lang} />}
										</h3>
										{item.tags.map((tag) => (
											<TagBadge lang={lang} tag={tag} />
										))}
									</div>
									<p class="text-body-md text-on-surface-variant">{item.description}</p>
								</div>
							</div>
							<div class="flex items-center gap-2 text-body-sm text-secondary shrink-0 pt-2 lg:pt-0 border-t lg:border-t-0 border-outline-variant/30">
								<Icon name="material-symbols:location-on" class="text-base" aria-hidden="true" />
								<span class="font-medium">{item.locationName}</span>
							</div>
						</article>
					))}
				</div>
			)
		}

		<div class="mt-8 text-center">
			<a
				class="inline-flex items-center gap-2 px-8 py-3.5 rounded bronze-border bg-surface text-secondary hover:bg-surface-container-high font-label-md uppercase tracking-wider font-semibold transition-all"
				href={`/${lang}/programme/`}
			>
				<span>{t(lang, 'button.seeFullProgramme')}</span>
				<Icon name="material-symbols:arrow-forward" aria-hidden="true" />
			</a>
		</div>
	</div>
</section>
