---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import {
	confirmedStat,
	formatEditionDates,
	visibleDays,
	visiblePlaces,
	type EditionData,
} from '../lib/editions';
import PlaceholderMark from './PlaceholderMark.astro';

interface Props {
	lang: Lang;
	editions: EditionData[];
}

const { lang, editions } = Astro.props;
const ordered = [...editions].sort((a, b) => b.year - a.year);
---

<section class="py-space-xl lg:py-28 bg-background" id="editions" data-component="Editions">
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="max-w-2xl mb-12">
			<div
				class="inline-block px-2.5 py-1 rounded mb-3 bronze-border bg-surface-container-high text-secondary text-eyebrow tracking-widest uppercase"
			>
				{t(lang, 'editions.eyebrow')}
			</div>
			<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
				{t(lang, 'editions.title')}
			</h2>
			<p class="text-body-md text-on-surface-variant mt-2">{t(lang, 'editions.lead')}</p>
		</div>

		<ul class="grid grid-cols-1 lg:grid-cols-2 gap-space-lg list-none p-0 m-0">
			{
				ordered.map((edition) => {
					const dates = formatEditionDates(edition, lang);
					const days = visibleDays(edition);
					const participants = confirmedStat(edition.stats?.participants);
					const countries = confirmedStat(edition.stats?.countries);
					const groups = confirmedStat(edition.stats?.groups);
					const nthKey = edition.number === 1 ? 'editions.nth.1' : 'editions.nth.2';

					return (
						<li class="bg-surface-container-low rounded-xl bronze-border p-6 lg:p-8 ambient-card flex flex-col gap-5">
							<div class="flex flex-wrap items-center justify-between gap-3">
								<span class="text-eyebrow text-primary font-bold tracking-widest">{edition.year}</span>
								<span class="text-label-sm uppercase tracking-wider text-secondary font-semibold">
									{t(lang, nthKey)}
								</span>
							</div>
							<div>
								<h3 class="text-headline-md text-on-surface font-semibold">{edition.name[lang]}</h3>
								{dates && <p class="text-body-md text-secondary font-semibold mt-1">{dates}</p>}
								<p class="text-body-md text-on-surface-variant mt-3">{edition.summary[lang]}</p>
							</div>

							{edition.theme && (
								<p class="text-body-sm text-on-surface italic border-l-2 border-primary/40 pl-3">
									{edition.theme[lang]}
								</p>
							)}

							<ul class="space-y-3 list-none p-0 m-0">
								{days.map((day) => (
									<li class="text-body-sm text-on-surface-variant">
										<span class="font-semibold text-on-surface">
											{day.label[lang]}
											{day.status === 'draft' && <PlaceholderMark lang={lang} />}
										</span>
										{visiblePlaces(day).map((place) => (
											<span class="block mt-0.5">
												{place.name[lang]}
												{place.status === 'draft' && <PlaceholderMark lang={lang} />}
												{place.note && (
													<span class="block text-on-surface-variant/90">{place.note[lang]}</span>
												)}
											</span>
										))}
									</li>
								))}
							</ul>

							{(participants || countries || groups) && (
								<div class="flex flex-wrap gap-2">
									{participants && (
										<span class="px-3 py-1 rounded bronze-border bg-surface text-label-sm font-semibold text-secondary">
											{participants.value} {t(lang, 'about.stats.participants')}
										</span>
									)}
									{countries && (
										<span class="px-3 py-1 rounded bronze-border bg-surface text-label-sm font-semibold text-secondary">
											{countries.value} {t(lang, 'about.stats.countries')}
										</span>
									)}
									{groups && (
										<span class="px-3 py-1 rounded bronze-border bg-surface text-label-sm font-semibold text-secondary">
											{groups.value} {t(lang, 'about.stats.groups')}
										</span>
									)}
								</div>
							)}

							<div class="mt-auto pt-2 flex flex-wrap gap-4">
								<a
									class="text-label-md text-primary font-semibold hover:underline"
									href={`/${lang}/gallery/?year=${edition.year}`}
								>
									{t(lang, 'button.seePhotos')} →
								</a>
								<a
									class="text-label-md text-secondary font-semibold hover:underline"
									href={`/${lang}/editions/${edition.year}/`}
								>
									{t(lang, 'editions.detailLink')} →
								</a>
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
