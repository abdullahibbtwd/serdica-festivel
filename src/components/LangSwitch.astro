---
import type { Lang } from '../i18n/ui';
import { getLocalizedPath, t } from '../i18n/utils';

interface Props {
	lang: Lang;
	pathname: string;
	class?: string;
	/** Use on dark backgrounds (footer). */
	tone?: 'light' | 'dark';
}

const { lang, pathname, class: className = '', tone = 'light' } = Astro.props;
const bgHref = getLocalizedPath(pathname, 'bg');
const enHref = getLocalizedPath(pathname, 'en');
const activeClass = tone === 'dark' ? 'text-surface-bright font-bold' : 'text-primary font-bold';
const idleClass =
	tone === 'dark'
		? 'text-surface-dim hover:text-surface-bright'
		: 'text-secondary hover:text-primary';
---

<div
	class:list={['lang-switch inline-flex items-center gap-1', className]}
	role="group"
	aria-label={t(lang, 'lang.switchLabel')}
>
	<a
		href={bgHref}
		lang="bg"
		hreflang="bg"
		aria-current={lang === 'bg' ? 'page' : undefined}
		class:list={['text-label-md tracking-wider transition-colors px-1 py-0.5', lang === 'bg' ? activeClass : idleClass]}
	>
		{t(lang, 'lang.bg')}
	</a>
	<span class:list={[tone === 'dark' ? 'text-surface-dim' : 'text-on-surface-variant/50']} aria-hidden="true">|</span>
	<a
		href={enHref}
		lang="en"
		hreflang="en"
		aria-current={lang === 'en' ? 'page' : undefined}
		class:list={['text-label-md tracking-wider transition-colors px-1 py-0.5', lang === 'en' ? activeClass : idleClass]}
	>
		{t(lang, 'lang.en')}
	</a>
</div>
