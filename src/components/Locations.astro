---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import LocationCard from './LocationCard.astro';
import MapIllustration from './MapIllustration.astro';

interface LocationItem {
	name: string;
	address: string;
	schedule?: string;
	transport?: string;
	mapUrl: string;
	isDraft: boolean;
	icon?: string;
	mapPin?: { lat: number; lng: number };
}

interface Props {
	lang: Lang;
	lead?: string;
	items: LocationItem[];
}

const { lang, lead, items } = Astro.props;
const pins = items
	.filter((item) => item.mapPin)
	.map((item) => ({
		name: item.name,
		lat: item.mapPin!.lat,
		lng: item.mapPin!.lng,
		mapUrl: item.mapUrl,
	}));
---

<section class="py-space-xl lg:py-28 bg-background" id="locations">
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		<div class="max-w-2xl mb-12">
			<div
				class="inline-block px-2.5 py-1 rounded mb-3 bronze-border bg-surface-container-high text-secondary text-eyebrow tracking-widest uppercase"
			>
				{t(lang, 'locations.eyebrow')}
			</div>
			<h2 class="text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight font-semibold">
				{t(lang, 'locations.title')}
			</h2>
			<p class="text-body-md text-on-surface-variant mt-2">{lead ?? t(lang, 'locations.lead')}</p>
		</div>

		{
			items.length === 0 ? (
				<p class="text-body-md text-on-surface-variant mb-space-xl">{t(lang, 'locations.empty')}</p>
			) : (
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
					<div class="lg:col-span-7 flex flex-col gap-6">
						{items.map((item, index) => (
							<LocationCard
								lang={lang}
								name={item.name}
								address={item.address}
								schedule={item.schedule}
								transport={item.transport}
								mapUrl={item.mapUrl}
								isDraft={item.isDraft}
								icon={item.icon ?? (index === 0 ? 'account-balance' : 'church')}
							/>
						))}
					</div>
					{pins.length > 0 && (
						<div class="lg:col-span-5">
							<MapIllustration lang={lang} pins={pins} />
						</div>
					)}
				</div>
			)
		}
	</div>
</section>
