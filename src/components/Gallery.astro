---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { GalleryFilter, GalleryItem } from '../lib/gallery';

interface Props {
	lang: Lang;
	items: GalleryItem[];
	/** preview = home teaser (no filters); full = gallery page with filters */
	variant?: 'preview' | 'full';
	showHeader?: boolean;
	initialFilter?: GalleryFilter;
}

const {
	lang,
	items,
	variant = 'full',
	showHeader = true,
	initialFilter = 'all',
} = Astro.props;

const years = [...new Set(items.map((item) => item.edition).filter(Boolean))] as Array<
	2025 | 2026
>;
years.sort((a, b) => b - a);

const groupFilters = [
	...new Map(
		items
			.filter((item) => item.group && item.groupLabel)
			.map((item) => [item.group!, item.groupLabel!] as const),
	),
].map(([id, label]) => ({ id, label }));

const filterOptions = [
	{ id: 'all' as const, label: t(lang, 'gallery.filterAll') },
	...groupFilters.map((g) => ({ id: g.id, label: g.label })),
	...years.map((year) => ({ id: String(year), label: String(year) })),
];

const showFilters = variant === 'full' && filterOptions.length > 1;
const lightboxId = variant === 'preview' ? 'gallery-lightbox-preview' : 'gallery-lightbox-full';

function itemMatchesFilter(item: GalleryItem, filter: GalleryFilter): boolean {
	if (filter === 'all') return true;
	if (filter === '2025' || filter === '2026') return item.edition === Number(filter);
	return item.group === filter;
}
---

<section
	class="py-space-xl lg:py-28 bg-dark-bg text-dark-text border-b border-accent-2/40"
	id="gallery"
	data-component="Gallery"
	data-variant={variant}
>
	<div class="max-w-7xl mx-auto px-4 md:px-margin">
		{
			showHeader && (
				<div class="max-w-2xl mb-8">
					<div class="inline-block px-2.5 py-1 rounded mb-3 bronze-border-dark bg-dark-surface text-badge-free text-eyebrow tracking-widest uppercase">
						{t(lang, 'gallery.eyebrow')}
					</div>
					<h2 class="text-headline-lg-mobile md:text-headline-lg text-surface-bright tracking-tight font-semibold">
						{t(lang, 'gallery.title')}
					</h2>
					<p class="text-body-md text-dark-muted mt-2">{t(lang, 'gallery.lead')}</p>
				</div>
			)
		}

		{
			items.length === 0 ? (
				<p class="text-body-md text-dark-muted">{t(lang, 'gallery.empty')}</p>
			) : (
				<>
					{showFilters && (
						<div class="flex flex-wrap gap-2 mb-8" role="tablist" aria-label={t(lang, 'gallery.title')}>
							{filterOptions.map((option) => (
								<button
									type="button"
									class:list={[
										'gallery-filter px-4 py-2 rounded font-label-sm text-label-sm uppercase tracking-wider font-semibold',
										initialFilter === option.id
											? 'bg-badge-free text-on-background'
											: 'bronze-border-dark bg-dark-surface text-badge-free hover:bg-[#26231F]',
									]}
									data-filter={option.id}
									aria-pressed={initialFilter === option.id ? 'true' : 'false'}
								>
									{option.label}
								</button>
							))}
						</div>
					)}

					<ul class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 list-none p-0 m-0">
						{items.map((item, index) => (
							<li
								data-edition={item.edition ?? ''}
								data-group={item.group ?? ''}
								class:list={[
									'gallery-item',
									showFilters && !itemMatchesFilter(item, initialFilter) ? 'hidden' : undefined,
								]}
							>
								<button
									type="button"
									class="gallery-trigger group relative aspect-[4/5] rounded overflow-hidden bronze-border-dark bg-dark-surface w-full cursor-pointer"
									data-gallery-index={index}
									aria-haspopup="dialog"
									aria-label={t(lang, 'gallery.open')}
								>
									<Image
										src={item.src}
										alt=""
										width={600}
										height={750}
										class="w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500"
										loading="lazy"
									/>
								</button>
							</li>
						))}
					</ul>

					{variant === 'preview' && (
						<div class="mt-10 text-center">
							<a
								class="inline-flex items-center gap-2 px-8 py-3.5 rounded bronze-border-dark bg-dark-surface text-badge-free hover:bg-[#26231F] font-label-md uppercase tracking-wider font-semibold transition-all"
								href={`/${lang}/gallery/`}
							>
								{t(lang, 'gallery.seeAll')}
							</a>
						</div>
					)}
				</>
			)
		}
	</div>

	{
		items.length > 0 && (
			<dialog
				id={lightboxId}
				class="m-auto max-w-[min(96vw,56rem)] w-full bg-dark-bg text-dark-text p-0 rounded bronze-border-dark shadow-xl backdrop:bg-black/70"
				aria-label={t(lang, 'gallery.title')}
			>
				<form method="dialog" class="flex justify-end p-2">
					<button
						type="submit"
						class="text-label-md uppercase tracking-wider px-3 py-2 hover:text-badge-free"
						value="close"
					>
						{t(lang, 'gallery.close')}
					</button>
				</form>
				<div class="px-4 pb-4">
					<img
						class="gallery-lightbox-img w-full h-auto max-h-[75vh] object-contain mx-auto"
						src=""
						alt=""
					/>
				</div>
			</dialog>
		)
	}
</section>

{
	items.length > 0 && (
		<script
			define:vars={{
				lightboxId,
				galleryData: items.map((item) => ({ src: item.src.src })),
				initialFilter,
			}}
		>
			const root = document.getElementById('gallery');
			const dialog = document.getElementById(lightboxId);
			const img = dialog?.querySelector('.gallery-lightbox-img');
			const triggers = Array.from(root?.querySelectorAll('.gallery-trigger') ?? []);
			const filters = Array.from(root?.querySelectorAll('.gallery-filter') ?? []);
			const itemsEl = Array.from(root?.querySelectorAll('.gallery-item') ?? []);
			let lastTrigger = null;
			let current = 0;

			function visibleIndexes() {
				return itemsEl
					.map((el, index) => ({ el, index }))
					.filter(({ el }) => !el.classList.contains('hidden'))
					.map(({ index }) => index);
			}

			function openAt(index, trigger) {
				if (!(dialog instanceof HTMLDialogElement) || !(img instanceof HTMLImageElement)) return;
				current = index;
				img.src = galleryData[index].src;
				img.alt = '';
				lastTrigger = trigger;
				dialog.showModal();
			}

			triggers.forEach((trigger) => {
				trigger.addEventListener('click', () => {
					const index = Number(trigger.getAttribute('data-gallery-index') || '0');
					openAt(index, trigger);
				});
			});

			dialog?.addEventListener('keydown', (event) => {
				if (!(event instanceof KeyboardEvent)) return;
				const visible = visibleIndexes();
				if (!visible.length) return;
				const pos = Math.max(0, visible.indexOf(current));
				if (event.key === 'ArrowRight') {
					event.preventDefault();
					openAt(visible[(pos + 1) % visible.length], lastTrigger);
				}
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					openAt(visible[(pos - 1 + visible.length) % visible.length], lastTrigger);
				}
			});

			function itemMatches(el, filter) {
				if (filter === 'all') return true;
				if (filter === '2025' || filter === '2026') {
					return el.getAttribute('data-edition') === filter;
				}
				return el.getAttribute('data-group') === filter;
			}

			function setFilter(filter) {
				filters.forEach((btn) => {
					const active = btn.getAttribute('data-filter') === filter;
					btn.setAttribute('aria-pressed', active ? 'true' : 'false');
					btn.classList.toggle('bg-badge-free', active);
					btn.classList.toggle('text-on-background', active);
					btn.classList.toggle('bronze-border-dark', !active);
					btn.classList.toggle('bg-dark-surface', !active);
					btn.classList.toggle('text-badge-free', !active);
				});
				itemsEl.forEach((el) => {
					el.classList.toggle('hidden', !itemMatches(el, filter));
				});
				const url = new URL(window.location.href);
				url.searchParams.delete('year');
				url.searchParams.delete('group');
				if (filter === '2025' || filter === '2026') url.searchParams.set('year', filter);
				else if (filter !== 'all') url.searchParams.set('group', filter);
				history.replaceState({}, '', url);
			}

			filters.forEach((btn) => {
				btn.addEventListener('click', () => setFilter(btn.getAttribute('data-filter') || 'all'));
			});

			const params = new URLSearchParams(window.location.search);
			const fromGroup = params.get('group');
			const fromYear = params.get('year');
			if (fromGroup) setFilter(fromGroup);
			else if (fromYear === '2025' || fromYear === '2026') setFilter(fromYear);
			else if (initialFilter !== 'all') setFilter(initialFilter);
		</script>
	)
}
