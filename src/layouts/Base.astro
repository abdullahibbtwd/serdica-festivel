---
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
import { getLocalizedPath, t } from '../i18n/utils';
import { editionStartEnd, type EditionData } from '../lib/editions';

interface FestivalData {
	mode: 'between-editions' | 'upcoming';
	nextEdition: 2025 | 2026 | null;
	admission: 'unknown' | 'free' | 'paid';
	email: string;
	facebook?: string;
	hero: {
		title: { bg: string; en: string };
		tagline: { bg: string; en: string };
	};
}

interface Props {
	lang: Lang;
	title: string;
	description: string;
	festival: FestivalData;
	pastEditions?: EditionData[];
	showProgramme?: boolean;
}

const {
	lang,
	title,
	description,
	festival,
	pastEditions = [],
	showProgramme = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateBg = new URL(getLocalizedPath(Astro.url.pathname, 'bg'), Astro.site);
const alternateEn = new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site);
const ogImage = new URL('/og/default.svg', Astro.site);

const organizationJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Serdica Aeterna Association',
	alternateName: 'Сдружение „Сердика Етерна"',
	url: Astro.site?.href,
	email: festival.email,
	address: {
		'@type': 'PostalAddress',
		addressLocality: t(lang, 'seo.city'),
		addressCountry: 'BG',
	},
};

if (festival.facebook) {
	organizationJsonLd.sameAs = [festival.facebook];
}

const eventJsonLdList = pastEditions
	.filter((edition) => edition.status === 'past')
	.map((edition) => {
		const { startDate, endDate } = editionStartEnd(edition);
		const event: Record<string, unknown> = {
			'@context': 'https://schema.org',
			'@type': 'Event',
			name: edition.name[lang],
			description: edition.summary[lang],
			eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
			image: [ogImage.href],
			organizer: {
				'@type': 'Organization',
				name: 'Serdica Aeterna Association',
				email: festival.email,
			},
			location: {
				'@type': 'Place',
				name: t(lang, 'seo.city'),
				address: {
					'@type': 'PostalAddress',
					addressLocality: t(lang, 'seo.city'),
					addressCountry: 'BG',
				},
			},
			inLanguage: [lang === 'bg' ? 'bg-BG' : 'en-GB'],
		};
		if (startDate) event.startDate = startDate;
		if (endDate) event.endDate = endDate;
		return event;
	});

const jsonLdGraph = [organizationJsonLd, ...eventJsonLdList];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={canonicalURL.href} />
		<link rel="alternate" hreflang="bg" href={alternateBg.href} />
		<link rel="alternate" hreflang="en" href={alternateEn.href} />
		<link rel="alternate" hreflang="x-default" href={alternateBg.href} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={t(lang, 'brand.name')} />
		<meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_GB'} />
		<meta property="og:locale:alternate" content={lang === 'bg' ? 'en_GB' : 'bg_BG'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:image" content={ogImage.href} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage.href} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
	</head>
	<body class="bg-background text-on-background antialiased flex flex-col min-h-screen">
		<a class="skip-link" href="#main">{t(lang, 'skip.toContent')}</a>
		<Header
			lang={lang}
			pathname={Astro.url.pathname}
			showFreeAdmission={festival.admission === 'free' && festival.mode === 'upcoming'}
			showProgramme={showProgramme}
		/>
		<main id="main" class="flex-grow w-full max-w-[100vw] overflow-x-hidden">
			<slot />
		</main>
		<Footer
			lang={lang}
			pathname={Astro.url.pathname}
			email={festival.email}
			showFreeAdmission={festival.admission === 'free' && festival.mode === 'upcoming'}
			showProgramme={showProgramme}
		/>
	</body>
</html>
