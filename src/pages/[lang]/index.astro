---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Editions from '../../components/Editions.astro';
import ExpectGrid from '../../components/ExpectGrid.astro';
import ParticipatingGroups from '../../components/ParticipatingGroups.astro';
import About from '../../components/About.astro';
import Gallery from '../../components/Gallery.astro';
import Partners from '../../components/Partners.astro';
import Media from '../../components/Media.astro';
import Contact from '../../components/Contact.astro';
import { isLang, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { isPublishedStatus, showDrafts } from '../../lib/drafts';
import {
	confirmedStat,
	formatEditionDatesCompact,
	type EditionData,
} from '../../lib/editions';
import { hasPublicProgramme } from '../../lib/programme';
import { getGroupPageHrefByLabel, getPublishedGroups } from '../../lib/groups';
import { galleryPreviewItems, getGalleryItems } from '../../lib/gallery';

export function getStaticPaths() {
	return [{ params: { lang: 'bg' } }, { params: { lang: 'en' } }];
}

const { lang: langParam } = Astro.params;
if (!langParam || !isLang(langParam)) {
	throw new Error(`Unsupported language: ${langParam}`);
}
const lang: Lang = langParam;

const festivalEntry = await getEntry('festival', 'festival');
if (!festivalEntry) {
	throw new Error('Missing festival.yaml content entry');
}
const festival = festivalEntry.data;
const draftsVisible = showDrafts();
const showProgramme = await hasPublicProgramme();

const editions = (await getCollection('editions'))
	.map((entry) => entry.data as EditionData)
	.sort((a, b) => b.year - a.year);

const latestPast = editions.find((e) => e.status === 'past');
const latestDates = latestPast ? formatEditionDatesCompact(latestPast, lang) : undefined;

const edition2026 = editions.find((e) => e.year === 2026);
const countriesConfirmed = confirmedStat(edition2026?.stats?.countries);
const participantsConfirmed = confirmedStat(edition2026?.stats?.participants);
const groupsConfirmed = confirmedStat(edition2026?.stats?.groups);

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) {
	throw new Error('Missing about content entry');
}
const about = aboutEntry.data;

const expectItems = (await getCollection('expect'))
	.filter((entry) => isPublishedStatus(entry.data.status))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		title: entry.data.title[lang],
		description: entry.data.description[lang],
		tag: entry.data.tag[lang],
		venueHint: entry.data.venueHint?.[lang],
		icon: entry.data.icon,
		image: entry.data.image,
		alt: entry.data.alt[lang],
		isKids: entry.data.isKids,
		isDraft: entry.data.status === 'draft',
	}));

const galleryPreview = galleryPreviewItems(await getGalleryItems(lang));

const partnerEntries = await getCollection('partners');

const partnerItems = partnerEntries
	.filter((entry) => isPublishedStatus(entry.data.status))
	.map((entry) => ({
		name: entry.data.name[lang],
		role: entry.data.role,
		editions: entry.data.editions,
		url: entry.data.url,
		isDraft: entry.data.status === 'draft',
	}))
	.sort((a, b) => a.name.localeCompare(b.name, lang));

const mediaItems = editions.flatMap((edition) =>
	(edition.media ?? [])
		.filter((item) => isPublishedStatus(item.status))
		.map((item) => ({
			outlet: item.outlet,
			title: item.title?.[lang],
			url: item.url,
			editionYear: edition.year,
			isDraft: item.status === 'draft',
		})),
);

const showFacebook =
	Boolean(festival.facebook) &&
	(festival.facebookStatus !== 'draft' || draftsVisible);
const showPhone =
	Boolean(festival.phone) && (festival.phoneStatus !== 'draft' || draftsVisible);

// Resolve upcoming dates if mode flips later
let upcomingDates: string | undefined;
if (festival.mode === 'upcoming' && festival.nextEdition) {
	const next = editions.find((e) => e.year === festival.nextEdition);
	if (next) upcomingDates = formatEditionDatesCompact(next, lang);
}

const groupHrefByLabel = await getGroupPageHrefByLabel(lang);
const publishedGroups = await getPublishedGroups();
const groupDraftByHref = new Map(
	publishedGroups.map((entry) => [`/${lang}/groups/${entry.data.id}/`, entry.isDraft]),
);
const participatingGroupCards = (edition2026?.participatingGroups ?? []).map((name) => {
	const href = groupHrefByLabel.get(name);
	return {
		name,
		href,
		isDraft: href ? Boolean(groupDraftByHref.get(href)) : false,
	};
});

---

<Base
	lang={lang}
	title={t(lang, 'home.metaTitle')}
	description={t(lang, 'home.metaDescription')}
	festival={festival}
	pastEditions={editions.filter((e) => e.status === 'past')}
	showProgramme={showProgramme}
>
	<Hero
		lang={lang}
		title={festival.hero.title[lang]}
		tagline={festival.hero.tagline[lang]}
		eyebrow={festival.hero.eyebrow[lang]}
		image={festival.hero.image}
		imageAlt={festival.hero.imageAlt[lang]}
		latestEditionDates={latestDates}
		mode={festival.mode}
		upcomingDates={upcomingDates}
		showFreeAdmission={festival.admission === 'free' && festival.mode === 'upcoming'}
		facebookUrl={showFacebook ? festival.facebook : undefined}
		showDraftMarkers={draftsVisible}
	/>

	<Editions lang={lang} editions={editions} />

	{expectItems.length > 0 && <ExpectGrid lang={lang} items={expectItems} />}

	{
		participatingGroupCards.length > 0 && (
			<ParticipatingGroups
				lang={lang}
				groups={participatingGroupCards}
				showFiveCountriesHeading={Boolean(countriesConfirmed)}
			/>
		)
	}

	<About
		lang={lang}
		eyebrow={about.eyebrow[lang]}
		title={about.title[lang]}
		lead={about.lead[lang]}
		mission={about.mission[lang]}
		paragraphs={about.paragraphs.map((p) => p[lang])}
		image={about.image}
		imageAlt={about.imageAlt?.[lang]}
		stats={{
			participants: participantsConfirmed?.value,
			countries: countriesConfirmed?.value,
			groups: groupsConfirmed?.value,
		}}
	/>

	<Gallery lang={lang} items={galleryPreview} variant="preview" />

	<Partners lang={lang} items={partnerItems} />

	<Media lang={lang} items={mediaItems} />

	<Contact
		lang={lang}
		email={festival.email}
		facebook={showFacebook ? festival.facebook : undefined}
		facebookIsDraft={festival.facebookStatus === 'draft'}
		phone={showPhone ? festival.phone : undefined}
		phoneIsDraft={festival.phoneStatus === 'draft'}
	/>
</Base>
