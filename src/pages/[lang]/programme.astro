---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagBadge from '../../components/TagBadge.astro';
import PlaceholderMark from '../../components/PlaceholderMark.astro';
import { isLang, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { getVisibleProgrammeDays, hasPublicProgramme } from '../../lib/programme';

export async function getStaticPaths() {
	if (!(await hasPublicProgramme())) {
		return [];
	}
	return [{ params: { lang: 'bg' } }, { params: { lang: 'en' } }];
}

const { lang: langParam } = Astro.params;
if (!langParam || !isLang(langParam)) {
	throw new Error(`Unsupported language: ${langParam}`);
}
const lang: Lang = langParam;

const festivalEntry = await getEntry('festival', 'festival');
if (!festivalEntry) {
	throw new Error('Missing festival.yaml content entry');
}
const festival = festivalEntry.data;
const programmeDays = await getVisibleProgrammeDays(lang);
---

<Base
	lang={lang}
	title={t(lang, 'programme.metaTitle')}
	description={t(lang, 'programme.metaDescription')}
	festival={festival}
	showProgramme={true}
>
	<section class="py-space-xl lg:py-28 px-4 md:px-margin max-w-4xl mx-auto">
		<h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface mb-space-lg">
			{t(lang, 'programme.title')}
		</h1>

		{
			programmeDays.length === 0 ? (
				<p class="text-body-md text-on-surface-variant">{t(lang, 'programme.empty')}</p>
			) : (
				<div class="space-y-space-xl">
					{programmeDays.map((day) => (
						<section aria-labelledby={`day-${day.id}`}>
							<h2 id={`day-${day.id}`} class="text-headline-md text-on-surface mb-space-md">
								{day.label}
							</h2>
							<ul class="space-y-3 list-none p-0 m-0">
								{day.items.map((item) => (
									<li class="bg-surface-container-low rounded-lg bronze-border p-5 ambient-card">
										<div class="flex flex-wrap items-baseline gap-3">
											<span class="text-headline-sm text-primary font-bold">{item.time}</span>
											<h3 class="text-headline-sm text-on-surface">
												{item.title}
												{item.isDraft && <PlaceholderMark lang={lang} />}
											</h3>
										</div>
										<p class="text-body-md text-on-surface-variant mt-2">{item.description}</p>
										<p class="text-body-sm text-secondary mt-2">{item.locationName}</p>
										{item.tags.length > 0 && (
											<div class="flex flex-wrap gap-2 mt-3">
												{item.tags.map((tag) => (
													<TagBadge lang={lang} tag={tag} />
												))}
											</div>
										)}
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			)
		}
	</section>
</Base>
