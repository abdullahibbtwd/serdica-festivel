---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PlaceholderMark from '../../../components/PlaceholderMark.astro';
import { isLang, t } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { isPublishedRights, isPublishedStatus } from '../../../lib/drafts';
import { renderMarkdown } from '../../../lib/markdown';
import { hasPublicProgramme } from '../../../lib/programme';

export async function getStaticPaths() {
	const groups = await getCollection('groups');
	const langs = ['bg', 'en'] as const;
	return langs.flatMap((lang) =>
		groups
			.filter((entry) => isPublishedStatus(entry.data.status))
			.map((entry) => ({
				params: { lang, id: entry.data.id },
				props: { group: entry.data },
			})),
	);
}

const { lang: langParam } = Astro.params;
if (!langParam || !isLang(langParam)) {
	throw new Error(`Unsupported language: ${langParam}`);
}
const lang: Lang = langParam;
const { group } = Astro.props;

const festivalEntry = await getEntry('festival', 'festival');
if (!festivalEntry) {
	throw new Error('Missing festival.yaml');
}
const festival = festivalEntry.data;
const showProgramme = await hasPublicProgramme();

const isDraft = group.status === 'draft';
const photos = group.photos.filter((photo) => isPublishedRights(photo.rightsConfirmed));
const hero = photos[0];
const storyHtml = renderMarkdown(group.story[lang]);
const lightboxId = 'group-lightbox';
---

<Base
	lang={lang}
	title={t(lang, 'group.metaTitle', { name: group.shortName[lang] })}
	description={t(lang, 'group.metaDescription', { name: group.name[lang] })}
	festival={festival}
	showProgramme={showProgramme}
>
	<section class="py-space-xl lg:py-28 bg-background" data-component="GroupPage">
		<div class="max-w-3xl mx-auto px-4 md:px-margin space-y-8">
			<div>
				<a class="text-label-md text-secondary hover:underline" href={`/${lang}/#groups`}>
					← {t(lang, 'groups.lead')}
				</a>
				<p class="text-eyebrow text-primary mt-4 uppercase tracking-widest">
					{t(lang, 'groups.eyebrow')}
				</p>
				<h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface mt-2">
					{group.name[lang]}
					{isDraft && <PlaceholderMark lang={lang} />}
				</h1>
				<p class="text-body-lg text-secondary font-semibold mt-2">{group.tagline[lang]}</p>
			</div>

			{
				hero ? (
					<div class="relative rounded-xl overflow-hidden bronze-border ambient-card">
						<Image
							src={hero.src}
							alt={hero.alt[lang]}
							width={1200}
							height={675}
							class="w-full h-[280px] md:h-[360px] object-cover object-center"
							loading="eager"
						/>
						{(!hero.rightsConfirmed || isDraft) && (
							<div class="absolute top-3 right-3">
								<PlaceholderMark lang={lang} />
							</div>
						)}
					</div>
				) : (
					<div
						class="rounded-xl bronze-border bg-surface-container-low h-[220px] md:h-[280px] flex items-center justify-center"
						aria-hidden="true"
					>
						{isDraft && <PlaceholderMark lang={lang} />}
					</div>
				)
			}

			{
				group.facts.length > 0 && (
					<div class="flex flex-wrap gap-3">
						{group.facts.map((fact) => (
							<span class="px-3 py-2 rounded bronze-border bg-surface-container-low text-label-sm">
								<span class="font-semibold text-on-surface">{fact.label[lang]}:</span>{' '}
								<span class="text-on-surface-variant">{fact.value[lang]}</span>
								{isDraft && <PlaceholderMark lang={lang} />}
							</span>
						))}
					</div>
				)
			}

			<div>
				<h2 class="text-headline-sm text-on-surface mb-3">{t(lang, 'group.story')}</h2>
				<div
					class="prose-group space-y-4 text-body-md text-on-surface-variant [&_strong]:text-on-surface [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1"
					set:html={storyHtml}
				/>
				{isDraft && <p class="mt-3"><PlaceholderMark lang={lang} /></p>}
			</div>

			{
				group.editions.length > 0 && (
					<div>
						<h2 class="text-headline-sm text-on-surface mb-3">{t(lang, 'group.editions')}</h2>
						<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
							{group.editions.map((year) => (
								<li>
									<a
										class="inline-flex px-3 py-1 rounded bronze-border text-label-sm font-semibold text-primary hover:bg-surface-container-low"
										href={`/${lang}/editions/${year}/`}
									>
										{year}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				group.links.length > 0 && (
					<div>
						<h2 class="text-headline-sm text-on-surface mb-3">{t(lang, 'group.links')}</h2>
						<ul class="space-y-2 list-none p-0 m-0">
							{group.links.map((link) => (
								<li>
									<a
										class="text-body-md text-primary hover:underline"
										href={link.url}
										rel="noopener noreferrer"
										target="_blank"
									>
										{link.label[lang]}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>
	</section>

	{
		photos.length > 0 && (
			<section class="py-space-xl lg:py-28 bg-dark-bg text-dark-text border-t border-accent-2/40" id="group-photos">
				<div class="max-w-7xl mx-auto px-4 md:px-margin">
					<div class="max-w-2xl mb-8">
						<div class="inline-block px-2.5 py-1 rounded mb-3 bronze-border-dark bg-dark-surface text-badge-free text-eyebrow tracking-widest uppercase">
							{t(lang, 'gallery.eyebrow')}
						</div>
						<h2 class="text-headline-lg-mobile md:text-headline-lg text-surface-bright tracking-tight font-semibold">
							{t(lang, 'group.photos')}
						</h2>
					</div>

					<ul class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 list-none p-0 m-0">
						{photos.map((photo, index) => (
							<li>
								<button
									type="button"
									class="group-photo-trigger group relative aspect-[4/5] rounded overflow-hidden bronze-border-dark bg-dark-surface w-full cursor-pointer"
									data-gallery-index={index}
									aria-haspopup="dialog"
									aria-label={t(lang, 'gallery.open')}
								>
									<Image
										src={photo.src}
										alt={photo.alt[lang]}
										width={600}
										height={750}
										class="w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500"
										loading="lazy"
									/>
									{!photo.rightsConfirmed && (
										<span class="absolute top-2 right-2">
											<PlaceholderMark lang={lang} />
										</span>
									)}
								</button>
							</li>
						))}
					</ul>
				</div>

				<dialog
					id={lightboxId}
					class="m-auto max-w-[min(96vw,56rem)] w-full bg-dark-bg text-dark-text p-0 rounded bronze-border-dark shadow-xl backdrop:bg-black/70"
					aria-label={t(lang, 'group.photos')}
				>
					<form method="dialog" class="flex justify-end p-2">
						<button
							type="submit"
							class="text-label-md uppercase tracking-wider px-3 py-2 hover:text-badge-free"
							value="close"
						>
							{t(lang, 'gallery.close')}
						</button>
					</form>
					<div class="px-4 pb-4">
						<img
							class="group-lightbox-img w-full h-auto max-h-[75vh] object-contain mx-auto"
							src=""
							alt=""
						/>
						<p class="group-lightbox-credit mt-3 text-body-sm text-dark-muted text-center"></p>
					</div>
				</dialog>

				<script
					define:vars={{
						lightboxId,
						galleryData: photos.map((photo) => ({
							src: photo.src.src,
							alt: photo.alt[lang],
							credit: photo.credit
								? `${t(lang, 'gallery.credit')}: ${photo.credit}`
								: '',
						})),
					}}
				>
					const root = document.getElementById('group-photos');
					const dialog = document.getElementById(lightboxId);
					const img = dialog?.querySelector('.group-lightbox-img');
					const creditEl = dialog?.querySelector('.group-lightbox-credit');
					const triggers = Array.from(root?.querySelectorAll('.group-photo-trigger') ?? []);
					let lastTrigger = null;
					let current = 0;

					function openAt(index, trigger) {
						if (!(dialog instanceof HTMLDialogElement) || !(img instanceof HTMLImageElement)) return;
						current = index;
						img.src = galleryData[index].src;
						img.alt = galleryData[index].alt;
						if (creditEl instanceof HTMLElement) {
							creditEl.textContent = galleryData[index].credit;
						}
						lastTrigger = trigger;
						dialog.showModal();
					}

					triggers.forEach((trigger) => {
						trigger.addEventListener('click', () => {
							const index = Number(trigger.getAttribute('data-gallery-index') || '0');
							openAt(index, trigger);
						});
					});

					dialog?.addEventListener('keydown', (event) => {
						if (!(event instanceof KeyboardEvent) || !galleryData.length) return;
						if (event.key === 'ArrowRight') {
							event.preventDefault();
							openAt((current + 1) % galleryData.length, lastTrigger);
						}
						if (event.key === 'ArrowLeft') {
							event.preventDefault();
							openAt((current - 1 + galleryData.length) % galleryData.length, lastTrigger);
						}
					});

					dialog?.addEventListener('close', () => {
						if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
					});
				</script>
			</section>
		)
	}
</Base>
